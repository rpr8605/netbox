{
  "name": "beacon-relay",
  "private": true,
  "type": "module",
  "description": "Beacon Relay remote hospital infrastructure monitoring appliance — device-identity foundation workspace.",
  "scripts": {
    "gen-types": "node scripts/gen_schema.js",
    "pki-seed": "node --env-file=.env scripts/pki_seed.js",
    "compose:up": "docker compose up -d step-ca control-plane",
    "test:db:reset": "node --env-file=.env control-plane/reset_test_db.js",
    "test": "npm run test:unit && npm run test:python",
    "test:unit": "npm run test:db:reset && node --env-file=.env --test scripts/test_device_lifecycle.js scripts/test_topology.js control-plane/test/migrate.once.test.js scripts/test_update_client.js scripts/test_ehr_unit.js scripts/test_configurator.js scripts/test_demo_seed.js scripts/test_step1_signals.js",
    "test:sqlite": "set DATABASE_URL=&& node --test scripts/test_device_lifecycle.js scripts/test_topology.js",
    "test:integration": "node --env-file=.env --test scripts/test_agent_loop.js scripts/test_ehr_e2e.js scripts/test_ota_rollout.js scripts/test_device_replace_e2e.js scripts/test_alerting_rbac_audit_support.js",
    "test:python": "python scripts/test_sidecar_security.py && python scripts/test_sidecar_correlation.py",
    "build:image": "node pipeline/build.js",
    "lint": "eslint . && ruff check scripts sidecar",
    "lint:fix": "eslint --fix . && ruff check --fix scripts sidecar",
    "format": "prettier --write \"**/*.{js,cjs,json,md,yml,yaml}\"",
    "demo": "node scripts/demo.js",
    "demo:seed": "node scripts/demo_seed.js",
    "demo:timeline": "node scripts/demo_timeline.js",
    "demo:reset": "node scripts/demo_reset.js"
  },
  "dependencies": {
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.9"
  }
}
