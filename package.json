{
  "name": "beacon-relay",
  "private": true,
  "type": "module",
  "description": "Beacon Relay remote hospital infrastructure monitoring appliance — Phase 1 workspace.",
  "scripts": {
    "gen-types": "node scripts/gen_schema.js",
    "pki-seed": "node scripts/pki_seed.js",
    "compose:up": "docker compose up -d step-ca control-plane",
