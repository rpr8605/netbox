    "ehr:unit": "node scripts/test_ehr_unit.js",
    "ehr:e2e": "node scripts/test_ehr_e2e.js",
    "demo": "node scripts/demo.js",
    "demo:seed": "node scripts/demo_seed.js",
    "demo:timeline": "node scripts/demo_timeline.js",
    "demo:reset": "node scripts/demo_reset.js"
  },
  "dependencies": {
    "jose": "^6.0.10"
  }
}
