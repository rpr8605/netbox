{
  "name": "beacon-relay",
  "private": true,
  "type": "module",
  "description": "Beacon Relay remote hospital infrastructure monitoring appliance — device-identity foundation workspace.",
  "scripts": {
    "gen-types": "node scripts/gen_schema.js",
    "pki-seed": "node --env-file=.env scripts/pki_seed.js",
    "compose:up": "docker compose up -d step-ca control-plane",
    "phase1:test": "docker compose up --build --abort-on-container-exit --exit-code-from device-sim",
    "phase3:build-image": "node pipeline/build.js",
    "test:db:reset": "node --env-file=.env control-plane/reset_test_db.js",
    "test": "npm run test:db:reset && node --env-file=.env --test scripts/test_device_lifecycle.js scripts/test_topology.js control-plane/test/migrate.once.test.js",
    "test:sqlite": "set DATABASE_URL=&& node --test scripts/test_device_lifecycle.js scripts/test_topology.js",
    "ehr:unit": "node --env-file=.env scripts/test_ehr_unit.js",
    "ehr:e2e": "node --env-file=.env scripts/test_ehr_e2e.js",
    "demo": "node scripts/demo.js",
    "demo:seed": "node scripts/demo_seed.js",
    "demo:timeline": "node scripts/demo_timeline.js",
    "demo:reset": "node scripts/demo_reset.js"
  },
  "dependencies": {
    "jose": "^6.0.10"
  }
}
