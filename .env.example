# .env.example — Beacon Relay local development defaults.
# Copy this file to `.env` and adjust values for your environment.
# `.env` is gitignored and must never be committed.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=beacon
# REQUIRED: no committed default. Choose a strong password and keep it in `.env`.
POSTGRES_PASSWORD=
POSTGRES_DB=beacon_relay
POSTGRES_HOST_PORT=5432

# Test database (used by test suites; DATABASE_URL must point to it).
POSTGRES_TEST_DB=beacon_relay_test

# Control-plane / test-suite database URL. Points at the isolated test database
# by default so `node --test` does not touch the compose dev database.
# Replace __POSTGRES_PASSWORD__ with the value you set above.
DATABASE_URL=postgres://beacon:__POSTGRES_PASSWORD__@localhost:5432/beacon_relay_test

# -----------------------------------------------------------------------------
# step-ca (private CA)
# -----------------------------------------------------------------------------
# REQUIRED: no committed default. This password protects the step-ca intermediate
# key. In production the key must be passphrase-protected and stored offline.
CA_PASSWORD=

# Provisioner used for device enrollment and certificate revocation.
PROVISIONER_NAME=beacon-relay-device

# Fingerprint of the step-ca root certificate. Leave empty to accept the
# fingerprint printed on first CA startup.
CA_FINGERPRINT=

# -----------------------------------------------------------------------------
# Control plane
# -----------------------------------------------------------------------------
# Container bind address. Use 0.0.0.0 inside Docker compose; use 127.0.0.1
# when running the control plane directly on a host.
BIND_HOST=0.0.0.0

# Published host port for the control-plane HTTPS API.
CONTROL_PLANE_HOST_PORT=10443

# DEMO_MODE=1 enables the demo banner and synthetic seed data.
DEMO_MODE=0

# Dev-only auth stub for the React console and API. Required in local dev/test
# until C1 (Cognito/OIDC operator auth) lands. Never set to 1 in production.
CONSOLE_DEV_AUTH=1
